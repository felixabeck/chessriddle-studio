{
  "name": "chessriddle-studio",
  "version": "0.15.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start-vite": "vite",
    "build-vite": "tsgo --noEmit && vite build",
    "build": "tauri build --no-bundle",
    "dev": "tauri dev --config src-tauri/tauri.dev.conf.json",
    "tauri": "tauri",
    "bindings:generate": "cargo run --manifest-path src-tauri/Cargo.toml --bin chessriddle-studio -- --export-bindings-only",
    "bindings:check": "node scripts/check-bindings.mjs",
    "skills:check": "node scripts/check-skill-bridges.mjs",
    "skills:bridges:test": "node --test scripts/check-skill-bridges-tests.mjs",
    "ci:remote:check": "node scripts/check-remote-ci.mjs",
    "ci:remote:test": "node --test scripts/check-remote-ci-tests.mjs",
    "gates:routing:check": "node scripts/check-gate-routing.mjs",
    "gates:routing:test": "node --test scripts/check-gate-routing-tests.mjs",
    "gates:contract:check": "pnpm mutation:guard:check && pnpm lint:ci && pnpm tauri:boundary:check && pnpm rust:surface:check && pnpm ui:boundary:check && pnpm skills:check && pnpm skills:bridges:test && pnpm gates:routing:check && pnpm gates:routing:test && pnpm ci:remote:test && pnpm tools:parity:check && pnpm tools:parity:test && pnpm workflows:check && pnpm workflows:permissions:test && pnpm ui:boundary:report:test && pnpm coverage:report:test && pnpm bundle:report:test && pnpm mutation:runner:test && pnpm rust:target:evict:test && pnpm gates:receipt:test && pnpm gates:logs:test && pnpm gates:parallelism:test && pnpm gates:push:test && pnpm gates:child-supervisor:test && pnpm gates:imports:test && pnpm rust:windows:test && pnpm entrypoint:test && pnpm e2e:launchers:test && pnpm install:local:test && pnpm app:driver:test && ./scripts/findings.py check && pnpm ipc:consumers:check",
    "gates:push": "bash \"$HOME/.claude/scripts/push-lock.sh\" gate -- agent-gate node scripts/run-push-gates.mjs",
    "checks:pre-review": "agent-gate node scripts/run-push-gates.mjs --pre-review",
    "gates:push:test": "node --test scripts/run-push-gates-tests.mjs",
    "gates:child-supervisor:test": "node --test scripts/child-supervisor-tests.mjs",
    "gates:imports:test": "node --test scripts/import-path-tests.mjs",
    "gate:ensure": "agent-gate node scripts/gate-receipt.mjs ensure",
    "gate:run": "agent-gate node scripts/gate-receipt.mjs run",
    "gate:check": "node scripts/gate-receipt.mjs check",
    "gates:receipt:test": "node --test scripts/gate-receipt-tests.mjs",
    "gates:logs:test": "node --test scripts/gate-logs-tests.mjs",
    "gates:parallelism:test": "node --test scripts/gate-parallelism-tests.mjs",
    "rust:windows:check": "node scripts/rust-windows-check.mjs",
    "rust:windows:test": "node --test scripts/rust-windows-check-tests.mjs",
    "rust:target:evict": "node scripts/rust-target-eviction.mjs",
    "rust:target:evict:test": "node --test scripts/rust-target-eviction-tests.mjs",
    "workflows:check": "node scripts/check-workflow-permissions.mjs && node scripts/check-workflow-permissions.mjs --actionlint",
    "workflows:permissions:test": "node --test scripts/check-workflow-permissions-tests.mjs",
    "tools:parity:check": "node scripts/check-tool-version-parity.mjs",
    "tools:parity:test": "node --test scripts/check-tool-version-parity-tests.mjs",
    "tauri:boundary:check": "node scripts/check-tauri-command-boundary.mjs",
    "rust:surface:check": "node scripts/check-rust-release-surface.mjs --check-allowlist-residency",
    "ui:boundary:check": "node scripts/check-ui-boundaries.mjs",
    "ui:boundary:report:test": "node --test scripts/check-ui-boundaries-tests.mjs",
    "format": "oxfmt",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage.enabled",
    "coverage:frontend:check": "node scripts/coverage-report.mjs --config coverage-areas.json --baseline coverage-baselines.json --lcov coverage/lcov.info",
    "coverage:mapping:frontend": "node scripts/coverage-report.mjs --config coverage-areas.json --baseline coverage-baselines.json --mapping-only",
    "coverage:baseline:frontend": "node scripts/coverage-report.mjs --config coverage-areas.json --baseline coverage-baselines.json --lcov coverage/lcov.info --write-baseline",
    "test:coverage:backend": "node scripts/ensure-output-directory.mjs backend-coverage && node scripts/rust-branch-coverage.mjs",
    "coverage:backend:check": "node scripts/coverage-report.mjs --config backend-coverage-areas.json --baseline backend-coverage-baselines.json --lcov backend-coverage/lcov.info",
    "coverage:mapping:backend": "node scripts/coverage-report.mjs --config backend-coverage-areas.json --baseline backend-coverage-baselines.json --mapping-only",
    "coverage:baseline:backend": "node scripts/coverage-report.mjs --config backend-coverage-areas.json --baseline backend-coverage-baselines.json --lcov backend-coverage/lcov.info --write-baseline",
    "coverage:report:test": "node --test scripts/coverage-report-tests.mjs",
    "entrypoint:test": "node --test scripts/entrypoint-tests.mjs",
    "install:local:test": "node --test scripts/install-local-tests.mjs",
    "app:driver:test": "node --test scripts/app-driver-tests.mjs",
    "bundle:check": "node scripts/check-bundle-budget.mjs",
    "bundle:report:test": "node --test scripts/check-bundle-budget-tests.mjs",
    "mutation:frontend": "node scripts/run-frontend-mutation.mjs",
    "mutation:backend": "node scripts/run-backend-mutation.mjs",
    "mutation:runner:test": "node --test scripts/run-backend-mutation-tests.mjs scripts/run-frontend-mutation-tests.mjs scripts/process-identity-tests.mjs",
    "mutation:guard:check": "node scripts/run-backend-mutation.mjs --check-guard",
    "findings:kit:check": "env -u KIT_ROOT kit sync --check .",
    "mutation": "pnpm mutation:frontend && pnpm mutation:backend",
    "lint": "tsgo --noEmit && oxlint --deny-warnings",
    "lint:ci": "tsgo --noEmit && oxfmt --check && oxlint --deny-warnings --format=github && i18next-cli extract --ci && pnpm i18n:jsx && pnpm i18n:check",
    "lint:fix": "oxlint --fix",
    "i18n:extract": "i18next-cli extract",
    "i18n:status": "i18next-cli status",
    "i18n:jsx": "node scripts/check-untranslated-jsx.mjs",
    "ipc:consumers:check": "node scripts/check-ipc-command-consumers.mjs",
    "i18n:check": "node scripts/i18n-completeness.mjs",
    "i18n:types": "i18next-cli types",
    "i18n:sync": "i18next-cli sync",
    "verify:app": "node scripts/verify-app.mjs",
    "verify:catalog-engines": "node scripts/verify-catalog-engines.mjs",
    "test:e2e": "node scripts/run-e2e-native.mjs",
    "test:e2e:container": "node scripts/run-e2e-container.mjs",
    "test:e2e:update": "node scripts/run-e2e-container.mjs --update-snapshots",
    "e2e:launchers:test": "node --test scripts/run-e2e-launchers-tests.mjs"
  },
  "dependencies": {
    "@badrap/result": "^0.2.13",
    "@hello-pangea/dnd": "^18.0.1",
    "@lichess-org/chessground": "^10.1.1",
    "@mantine/charts": "^8.3.14",
    "@mantine/core": "^8.3.14",
    "@mantine/dates": "^8.3.14",
    "@mantine/form": "^8.3.14",
    "@mantine/hooks": "^8.3.14",
    "@mantine/notifications": "^8.3.14",
    "@mantine/tiptap": "^8.3.14",
    "@tanstack/react-router": "^1.161.1",
    "@tanstack/react-virtual": "^3.13.18",
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/plugin-cli": "^2.4.1",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "@tauri-apps/plugin-log": "^2.8.0",
    "@tauri-apps/plugin-os": "^2.3.2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.11.0",
    "@tauri-apps/plugin-window-state": "~2.4.1",
    "@tiptap/extension-link": "3.20.0",
    "@tiptap/extension-placeholder": "3.20.0",
    "@tiptap/extension-underline": "3.20.0",
    "@tiptap/markdown": "^3.20.0",
    "@tiptap/pm": "3.20.0",
    "@tiptap/react": "3.20.0",
    "@tiptap/starter-kit": "3.20.0",
    "@vitejs/plugin-react": "^6.0.0",
    "chessops": "^0.14.0",
    "clsx": "^2.0.0",
    "dayjs": "^1.11.10",
    "dom-to-image": "^2.6.0",
    "fast-deep-equal": "^3.1.3",
    "fuse.js": "^7.0.0",
    "i18next": "^25.8.11",
    "i18next-browser-languagedetector": "^8.2.1",
    "immer": "^11.1.4",
    "jotai": "^2.18.1",
    "lucide-react": "1.61.0",
    "lz-string": "^1.5.0",
    "mantine-contextmenu": "^8.3.13",
    "mantine-datatable": "^8.3.13",
    "mantine-flagpack": "^4.1.1",
    "marked": "17.0.3",
    "proxy-memoize": "^3.0.1",
    "react": "^19.2.4",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dom": "^19.2.4",
    "react-draggable": "^4.5.0",
    "react-hotkeys-hook": "^4.5.0",
    "react-i18next": "^16.5.4",
    "react-mosaic-component": "^6.1.1",
    "recharts": "^3.7.0",
    "swr": "^2.4.0",
    "ts-fsrs": "^3.5.1",
    "ts-pattern": "^5.0.8",
    "vite": "^8.0.0",
    "zod": "^3.22.4",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@babel/core": "^7.29.0",
    "@playwright/test": "1.62.1",
    "@rolldown/plugin-babel": "^0.2.1",
    "@stryker-mutator/core": "9.6.1",
    "@stryker-mutator/vitest-runner": "9.6.1",
    "@tanstack/router-plugin": "^1.161.1",
    "@tauri-apps/cli": "2.10.0",
    "@types/babel__core": "^7.20.5",
    "@types/dom-to-image": "^2.6.7",
    "@types/lodash": "^4.17.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript/native-preview": "7.0.0-dev.20260306.1",
    "@vitest/coverage-v8": "4.1.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "i18next-cli": "^1.42.12",
    "jsdom": "^28.1.0",
    "oxfmt": "^0.40.0",
    "oxlint": "^1.55.0",
    "oxlint-tsgolint": "^0.16.0",
    "typescript-plugin-css-modules": "^5.2.0",
    "vitest": "^4.1.0"
  },
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.34.5"
}
